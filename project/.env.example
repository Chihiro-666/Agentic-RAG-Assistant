# Langfuse 可观测性（可选）
# 设置 LANGFUSE_ENABLED=true 并填写 API 密钥以启用调用链追踪。
# 可从 https://cloud.langfuse.com 或自托管实例获取密钥。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# Ollama 聊天模型；首次启动且尚未安装模型时，start.bat 会尝试下载此模型。
OLLAMA_MODEL=llama3.1:8b
